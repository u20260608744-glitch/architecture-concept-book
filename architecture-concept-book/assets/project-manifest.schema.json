{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/u20260608744-glitch/architecture-concept-book/v1.0.0/architecture-concept-book/assets/project-manifest.schema.json",
  "title": "Architecture concept book manifest 1.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "phase": {
      "enum": [
        "planning",
        "production",
        "delivery"
      ]
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "project_type": {
          "type": "string"
        },
        "stage": {
          "type": [
            "string",
            "null"
          ]
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "continuous_decimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        }
      },
      "required": [
        "title",
        "project_type",
        "stage",
        "languages",
        "continuous_decimals"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "brief",
              "drawing",
              "model",
              "survey",
              "data",
              "image",
              "generated_image",
              "reference",
              "other"
            ]
          },
          "status": {
            "enum": [
              "read",
              "unread",
              "missing"
            ]
          },
          "sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "authority": {
            "type": "string"
          },
          "license": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "path",
          "kind",
          "status",
          "sha256",
          "authority",
          "license"
        ]
      }
    },
    "schemes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ]
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "label": {
            "type": "string"
          },
          "scheme_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "quantity_kind": {
            "enum": [
              "continuous",
              "count",
              "text"
            ]
          },
          "value": {
            "type": [
              "number",
              "string",
              "null"
            ]
          },
          "unit": {
            "type": "string"
          },
          "status": {
            "enum": [
              "source",
              "derived",
              "assumption",
              "unknown"
            ]
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
            },
            "uniqueItems": true
          },
          "locator": {
            "type": "string"
          },
          "blocking_unknown": {
            "type": "boolean"
          },
          "formula": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "enum": [
                  "sum",
                  "difference",
                  "product",
                  "ratio",
                  "percent"
                ]
              },
              "inputs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
                },
                "minItems": 1
              },
              "tolerance": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "op",
              "inputs"
            ]
          }
        },
        "required": [
          "id",
          "label",
          "scheme_id",
          "quantity_kind",
          "value",
          "unit",
          "status",
          "source_ids",
          "locator"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "quantity_kind": {
                  "enum": [
                    "continuous",
                    "count"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "quantity_kind": {
                  "const": "text"
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "figures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "status": {
            "enum": [
              "planned",
              "ready"
            ]
          },
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "kind": {
            "enum": [
              "native",
              "analysis",
              "diagram",
              "generated_visual",
              "reference"
            ]
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
            },
            "uniqueItems": true
          },
          "scheme_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
            },
            "uniqueItems": true
          },
          "caption": {
            "type": "string"
          },
          "camera": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "projection": {
                "enum": [
                  "orthographic",
                  "two_point",
                  "perspective"
                ]
              },
              "native_scene": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "model_sha256": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "view_group": {
                "type": "string"
              }
            },
            "required": [
              "projection"
            ]
          }
        },
        "required": [
          "id",
          "status",
          "path",
          "sha256",
          "kind",
          "source_ids",
          "scheme_ids",
          "caption"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "ready"
                }
              }
            },
            "then": {
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        ]
      }
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "section": {
            "type": "string"
          },
          "layout": {
            "enum": [
              "hero",
              "analysis",
              "masterplan",
              "comparison",
              "text",
              "custom"
            ]
          },
          "scheme_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
            },
            "uniqueItems": true
          },
          "figure_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
            },
            "uniqueItems": true
          },
          "fact_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
            },
            "uniqueItems": true
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
            },
            "uniqueItems": true
          },
          "body": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "order",
          "title",
          "claim",
          "section",
          "layout",
          "scheme_ids",
          "figure_ids",
          "fact_ids",
          "source_ids",
          "body"
        ]
      }
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "kind": {
            "enum": [
              "pdf",
              "editable",
              "web",
              "other"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "source_snapshot": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "source_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "source_id",
                "sha256"
              ]
            }
          }
        },
        "required": [
          "id",
          "kind",
          "path",
          "sha256",
          "source_snapshot"
        ]
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "content",
              "numeric",
              "visual",
              "delivery"
            ]
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "not_run",
              "not_applicable"
            ]
          },
          "target_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "target_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "evidence_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "observations": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "status",
          "target_id",
          "target_sha256",
          "evidence_path",
          "evidence_sha256",
          "observations"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "pass"
                }
              }
            },
            "then": {
              "properties": {
                "evidence_path": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "observations": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "phase",
    "project",
    "sources",
    "schemes",
    "facts",
    "figures",
    "pages",
    "deliverables",
    "checks"
  ]
}
